{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/work/opengraph-image-:hash",
      "headers": [{ "key": "content-type", "value": "image/png" }]
    },
    {
      "source": "/work/:slug/opengraph-image-:hash",
      "headers": [{ "key": "content-type", "value": "image/png" }]
    }
  ]
}
